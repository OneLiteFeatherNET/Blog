---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
import {Image} from "astro:assets";
---
<header class="container mx-auto">
	<nav class="relative flex items-center justify-between flex-row px-4 text-slate-600 ">
		<div class="flex items-center">
			<Image src="/assets/logo.svg" alt="onelitefeather brand logo" class="h-25 w-25" width="150" height="150"/>
			<h2 class="font-montserrat font-bold text-2xl relative">
				<a href="/">{SITE_TITLE}</a>
			</h2>
		</div>
		<div class="flex items-center mx-2 ">
			<HeaderLink href={"/" + Astro.currentLocale + "/"} class="px-2">Home</HeaderLink>
			<HeaderLink href={"/" + Astro.currentLocale + "/projects"} class="px-2">Projects</HeaderLink>
			<HeaderLink href={"/" + Astro.currentLocale + "/blog"} class="px-2">Blog</HeaderLink>
			<HeaderLink href="/" class="px-2 last:border-solid last:border-l-2 hover:border-l-slate-800">Discord</HeaderLink>
		</div>
	</nav>
</header>