---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../../consts';
import {getCollection} from 'astro:content';
import Project from "../../../layouts/Project.astro";


const projects = (await getCollection('project', ({data }) => {
	return data.language.startsWith(Astro.currentLocale as string);
})) as any[];
---

<!doctype html>
<html lang={Astro.currentLocale}>
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={SITE_TITLE}
			href={new URL("rss.xml", Astro.site)}
		/>
	</head>
	<body>
		<Header />
		<main class="mx-96">
			<section class="w-full">
				<h1 class="text-center">Unsere Open-Source Projekte</h1>
				<ul class="mx-4 grid grid-flow-row grid-cols-3 gap-4 mt-8">
					{
						projects.map((project) => {
							return (
								<Project {...project} />
							)
						})
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
