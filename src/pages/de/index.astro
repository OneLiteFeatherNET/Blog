---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { Image } from "astro:assets";
---

<!doctype html>
<html lang={Astro.currentLocale}>
    <head>
        <BaseHead title="OneLiteFeather Netzwerk" description="OneLiteFeather ist ein Open Source Netzwerk mit dem Fokus Studenten, Auszubildene und Jugendlichen eine Perspektive zu geben." image="/assets/logo.svg"/>
    </head>
    <body>
        <Header />
        <main>
            <section class="h-64 mx-auto container">
                <div class="grid grid-flow-col grid-cols-2 h-max justify-center w-full">
                    <div class="w-full my-auto relative mx-auto row-span-2 col-span-1 text-right justify-items-end">
                        <h1 class="w-max text-right my-4 text-transparent bg-clip-text bg-gradient-to-r from-brand-orange from-0% via-brand-pink via-50% via-brand-purple via-75% to-brand-blue to-100% dark:bg-gradient-to-r dark:from-brand-orange dark:from-0% dark:via-brand-pink via-50% dark:via-brand-purple via-100%
">OneLiteFeather</h1>
                        <p class="font-bold">OneLiteFeather ist ein Open Source Netzwerk mit dem Fokus <br>
                            Studenten, Auszubildene und Jugendlichen eine Perspektive zu geben.</p>
                    </div>
                    <div class="w-full relative row-span-2 col-span-2 justify-items-start">
                        <div class="h-88 w-88 grid">
                            <Image src={"/assets/logo.svg"} alt="onelitefeather brand logo as a rainbow feather" width="350" height="350" class={"col-start-1 row-start-1 relative z-10 "}>

                            </Image>
                            <!--<div class="col-start-1 row-start-1 relative -inset-1 bg-gradient-to-r from-brand-orange from-0% via-brand-pink via-50% via-brand-purple via-75% to-brand-blue to-100% rounded-lg blur opacity-25"></div>-->

                        </div>


                    </div>
                </div>

            </section>
            <!--<section class="h-64 mx-auto container">


            </section>-->
        </main>
        <Footer />
    </body>
</html>